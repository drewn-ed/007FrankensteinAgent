GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MODEL_PROVIDER=gemini
# Select chatgpt through Settings after completing Continue with ChatGPT.
# This uses the official OAuth flow, not an OPENAI_API_KEY or a Codex token.
CHATGPT_MODEL=
# Set true only after verifying this key's Google AI Studio project uses Free tier.
# The API does not provide a per-request "free-only" switch.
GEMINI_FREE_TIER_CONFIRMED=false
MAX_MODEL_CALLS=18
MAX_OUTPUT_TOKENS=8192
MAX_RUN_SECONDS=240
SANDBOX_IMAGE=python:3.12-slim

# Strict monetary admission blocks unpriced routes before inference.
MAX_RUN_USD=0
SPEND_POLICY=strict
# ChatGPT plan inference is unpriced locally and blocked by strict mode.
# Explicit existing_plan mode uses provider-managed plan/credit limits;
# it does NOT provide a local USD spending guarantee. No paid fallback.
